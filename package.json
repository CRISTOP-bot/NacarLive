{
  "name": "nacar-live",
  "version": "2.0.0",
  "description": "Monitor de builds y releases de Nácar GNU/Linux y DylanOS",
  "main": "electron/main.cjs",
  "author": "CRISTOP-bot",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "check": "node --check app.js && node --check build-version.js && node --check electron/main.cjs && node --check .github/scripts/set-build-version.cjs && node --check .github/scripts/copy-web.cjs && node --check .github/scripts/set-android-version.cjs",
    "build:web": "node .github/scripts/copy-web.cjs",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "mx.cristopbot.nacarlive",
    "productName": "Nácar Live",
    "directories": { "output": "release" },
    "files": ["index.html", "styles.css", "app.js", "build-version.js", "electron/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
